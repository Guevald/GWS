      "path": "."
    },
    {
      "name": "claude-config",
      "path": "../.claude/claude-config"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/*.exe": true,
      "**/*.zip": true,
      "**/google-cloud-cli-windows-x86_64": true,
      "**/google-workspace-cli-x86_64-pc-windows-msvc": true
